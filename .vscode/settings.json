{
  "workbench.colorCustomizations": {
    "activityBar.background": "#091c41",
    "titleBar.activeBackground": "#242f8e",
    "titleBar.activeForeground": "#ffffff",
    "titleBar.inactiveBackground": "#0C2555",
    "titleBar.inactiveForeground": "#FBFDFF",
    "statusBar.background": "#0C2555",
    "statusBar.foreground": "#FBFDFF",
    "statusBar.debuggingBackground": "#0C2555",
    "statusBar.debuggingForeground": "#FBFDFF",
    "statusBar.noFolderBackground": "#0C2555",
    "statusBar.noFolderForeground": "#FBFDFF"
  },
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "eslint.nodePath": null,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // TypeScript performance and file watching optimisations
  "typescript.tsserver.maxTsServerMemory": 8192,
  "typescript.disableAutomaticTypeAcquisition": true,
  "typescript.tsserver.experimental.enableProjectDiagnostics": false,
  "typescript.tsserver.watchOptions": {
    "excludeDirectories": [
      "**/node_modules",
      "**/.pnpm",
      "**/node_modules/.pnpm",
      "**/dist",
      "**/build",
      "**/.next"
    ]
  },

  // File watcher exclusions (prevents VS Code from watching these directories)
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.pnpm/**": true,
    "**/node_modules/.pnpm/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.next/**": true,
    "**/coverage/**": true
  },

  // Search exclusions (improves search performance)
  "search.exclude": {
    "**/node_modules": true,
    "**/.pnpm": true,
    "**/dist": true,
    "**/build": true,
    "**/coverage": true
  }
}
