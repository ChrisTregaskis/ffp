{
  "name": "ffp",
  "version": "0.0.0",
  "private": true,
  "description": "Fit For Purpose - Multi-tenant physiotherapy assessment and workout platform",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:core": "turbo dev --filter=@ffp/core",
    "dev:functions": "turbo dev --filter=@ffp/functions",
    "dev:web": "turbo dev --filter=@ffp/web",
    "lint": "pnpm run lint:root && turbo lint",
    "lint:root": "eslint . --ext js --max-warnings 0 --ignore-pattern 'packages/**'",
    "lint:fix": "pnpm run lint:root --fix && turbo lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint-format": "pnpm run lint:fix && pnpm run format",
    "test": "turbo test",
    "test:root": "vitest run tests/",
    "test:root:watch": "vitest tests/",
    "test:root:ui": "vitest --ui tests/",
    "test:unit": "vitest run --exclude='**/*.integration.test.ts'",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm run typecheck:root && turbo typecheck",
    "typecheck:root": "tsc --project scripts/tsconfig.json",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate --filter=@ffp/database",
    "db:migrate": "turbo run db:migrate --filter=@ffp/database",
    "db:push": "turbo run db:push --filter=@ffp/database",
    "db:studio": "turbo run db:studio --filter=@ffp/database",
    "db:drop": "turbo run db:drop --filter=@ffp/database",
    "db:check": "turbo run db:check --filter=@ffp/database",
    "db:test": "tsx scripts/test-db-connection.ts",
    "db:verify": "turbo run db:verify --filter=@ffp/database",
    "bootstrap:super-admin": "tsx scripts/bootstrap-super-admin.ts",
    "sst:dev": "sst dev",
    "sst:build": "sst build",
    "sst:deploy": "sst deploy",
    "sst:deploy:dev": "sst deploy --stage dev",
    "sst:deploy:staging": "sst deploy --stage staging",
    "sst:remove": "sst remove",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky"
  },
  "devDependencies": {
    "@ffp/eslint-config": "workspace:*",
    "@ffp/prettier-config": "workspace:*",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.15.5",
    "@vitest/ui": "^2.1.4",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.5",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.8.3",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "only-allow": "^1.2.1",
    "pg": "^8.16.3",
    "prettier": "^3.3.3",
    "sst": "^3.17.21",
    "tsx": "^4.20.6",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "zod": "^3.25.0"
  },
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
