{
  "name": "@ffp/functions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@ffp/core": "workspace:*",
    "@aws-sdk/client-cognito-identity-provider": "^3.705.0",
    "@aws-sdk/client-s3": "^3.705.0"
  },
  "devDependencies": {
    "@ffp/eslint-config": "workspace:*",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.9.0",
    "@vitest/ui": "^2.1.4",
    "eslint": "^8.57.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
