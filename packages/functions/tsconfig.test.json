{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "types": ["vitest/globals"],

    // Test-specific path aliases
    "baseUrl": "./src",
    "paths": {
      "@functions/auth/*": ["./auth/*"],
      "@functions/assessments/*": ["./assessments/*"],
      "@functions/business/*": ["./business/*"],
      "@functions/programmes/*": ["./programmes/*"],
      "@functions/videos/*": ["./videos/*"],
      "@functions/utils/*": ["./utils/*"],
      "@functions/types/*": ["./types/*"],
      "@functions/lib/*": ["./lib/*"],
      "@functions/services/*": ["./services/*"]
    }
  },
  "include": [
    "tests/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*"
  ],
  "exclude": ["node_modules", "dist"],
  "references": [
    {
      "path": "../core"
    }
  ]
}
