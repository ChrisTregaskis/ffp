{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,

    // Internal path aliases for cleaner imports within this package
    "baseUrl": "./src",
    "paths": {
      // Workspace imports (inherited from base, redeclared for clarity)
      "@ffp/core": ["../../core/dist"],
      "@ffp/core/*": ["../../core/dist/*"],

      // Internal aliases for this package
      "@/auth/*": ["./auth/*"],
      "@/assessments/*": ["./assessments/*"],
      "@/business/*": ["./business/*"],
      "@/programs/*": ["./programs/*"],
      "@/videos/*": ["./videos/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"],
  "references": [
    {
      "path": "../core"
    }
  ]
}
