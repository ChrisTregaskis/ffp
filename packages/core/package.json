{
  "name": "@ffp/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.705.0",
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/cloudfront-signer": "^3.999.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@ffp/database": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@ffp/eslint-config": "workspace:*",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.15.5",
    "@vitest/ui": "^3.2.4",
    "drizzle-zod": "^0.8.3",
    "eslint": "^8.57.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
