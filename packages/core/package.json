{
  "name": "@ffp/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@ffp/eslint-config": "workspace:*",
    "@types/node": "^22.9.0",
    "@vitest/ui": "^2.1.4",
    "eslint": "^8.57.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
