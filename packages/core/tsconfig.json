{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,

    // Internal path aliases for cleaner imports within this package
    "baseUrl": "./src",
    "paths": {
      "@core/lib/*": ["./lib/*"],
      "@core/types/*": ["./types/*"],
      "@core/utils/*": ["./utils/*"],
      "@core/services/*": ["./services/*"],
      "@core/repositories/*": ["./repositories/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
