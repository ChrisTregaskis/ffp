{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,

    // Internal path aliases for cleaner imports within this package
    "baseUrl": "./src",
    "paths": {
      // Internal aliases for this package using @web/ namespace to avoid conflicts
      "@web/components/*": ["./components/*"],
      "@web/hooks/*": ["./hooks/*"],
      "@web/pages/*": ["./pages/*"],
      "@web/services/*": ["./services/*"],
      "@web/utils/*": ["./utils/*"],
      "@web/types/*": ["./types/*"],
      "@web/lib/*": ["./lib/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "vite.config.ts",
    "vite-alias-config.ts",
    ".eslintrc.cjs",
    "postcss.config.js",
    "tailwind.config.js"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "../core"
    }
  ]
}
