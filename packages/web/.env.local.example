# AWS Cognito Configuration
# These values are used by AWS Amplify to connect to the Cognito User Pool
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Log level control to avoid logs in prod
VITE_LOG_LEVEL=
# Explicitly environment setup
ENVIRONMENT=

# API Gateway URL (from SST deploy output)
VITE_API_URL=