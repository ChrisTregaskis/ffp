# Showcase build configuration (vite build --mode showcase)
#
# Keeps the dev-only /components/* prototypes in the bundle so stakeholders can
# click through them on a static host with no backend. These prototypes make no
# network, database or auth calls, so every value below is a deliberate dummy.
#
# NEVER put real Cognito or API values here: this file is committed and the
# resulting bundle is hosted publicly (gated only by Cloudflare Access).
VITE_SHOWCASE=true

# Dummy backend config. VITE_API_URL must be non-empty (the API client throws at
# module load if it is unset), but the value is unreachable and never called.
VITE_API_URL=https://showcase.invalid
VITE_COGNITO_USER_POOL_ID=showcase-none
VITE_COGNITO_CLIENT_ID=showcase-none

# Quieten runtime logging in the hosted preview.
VITE_LOG_LEVEL=ERROR
