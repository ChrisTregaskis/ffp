{
  // Typechecks the tests against the app config, so paths and lib can't drift from it.
  // Read by `pnpm typecheck` and by ESLint.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
