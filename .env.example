# Environment: development locally. Deployed functions receive production or production-like
# from the stage's runtime profile; the migration reads it to decide FORCE RLS.
ENVIRONMENT=development

# Update with the profile you've set up on AWS - this is used so that running scripts loads the relevant aws cli credentials
AWS_PROFILE=ffp-dev
AWS_REGION=eu-west-2

# Database Configuration (Local PostgreSQL for development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ffp_dev
DB_USER=ffp_user
DB_PASSWORD=your_secure_password_here
# Database TLS: 'local' turns TLS off for local Postgres; anything else verifies against the RDS CA
DB_TLS_MODE=local

# Migration role: owns the schema objects; connects with its own password, never DB_PASSWORD.
# Migrations, drizzle-kit, the seeds and the super-admin bootstrap all connect as this role.
DB_MIGRATE_USER=root_user
DB_MIGRATE_PASSWORD=your_migrate_password_here

# Test role given the same grants as DB_USER by the migration. Set it only when migrating
# ffp_test (the vitest suites connect as test_user); refused on a deployed environment.
DB_TEST_USER=

# The first system admin (pnpm bootstrap:super-admin); Cognito emails them a temporary password.
# The names are optional and default to System / Admin.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_FIRST_NAME=
SUPER_ADMIN_LAST_NAME=

# AWS Continued
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# The user pool's region, for every Cognito call (defaults to eu-west-2)
COGNITO_REGION=eu-west-2

# Log level for controlling what logs get logged. Optimisation for production - for production, set to INFO for example. Omitting DEBUG logs.
LOG_LEVEL=DEBUG