{
  "name": "FFP - Development",
  "values": [
    {
      "key": "apiUrl",
      "value": "https://your-api-url.execute-api.eu-west-2.amazonaws.com",
      "type": "default",
      "enabled": true,
      "description": "API Gateway URL from `sst dev` or `sst deploy --stage dev` outputs"
    },
    {
      "key": "userPoolId",
      "value": "eu-west-2_XXXXXXXXX",
      "type": "default",
      "enabled": true,
      "description": "Cognito User Pool ID from SST outputs"
    },
    {
      "key": "userPoolClientId",
      "value": "your-client-id-here",
      "type": "default",
      "enabled": true,
      "description": "Cognito User Pool Client ID from SST outputs"
    },
    {
      "key": "region",
      "value": "eu-west-2",
      "type": "default",
      "enabled": true,
      "description": "AWS Region (London)"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "JWT token obtained after login (paste here after authentication)"
    },
    {
      "key": "idToken",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "ID token from Cognito (contains user claims)"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "Refresh token for obtaining new access tokens"
    },
    {
      "key": "tenantId",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Current tenant ID for testing (extracted from JWT custom:tenantId)"
    },
    {
      "key": "userId",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Current authenticated user ID for testing"
    }
  ],
  "_postman_variable_scope": "environment"
}
